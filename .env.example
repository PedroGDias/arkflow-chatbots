# WhatsApp Cloud API (Meta for Developers > your app > WhatsApp > API Setup)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Any string you choose — must match what you enter in the Meta webhook config
WHATSAPP_VERIFY_TOKEN=

# Supabase (Project Settings > API)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic (console.anthropic.com > API Keys)
ANTHROPIC_API_KEY=

# Arkflow ERP project — catalog, customers, and orders live here
ERP_SUPABASE_URL=
ERP_SUPABASE_SERVICE_ROLE_KEY=
ARKFLOW_CLIENT_ID=
# automations.id for this bot's telemetry (runs) rows
ARKFLOW_AUTOMATION_ID=

# OPTIONAL — leave unset unless you specifically want chat transcripts to show up
# under a different workspace than the one the bot books orders into. Unset means
# both fall back to the two vars above, which keeps an order and the conversation
# that produced it on the same client.
# ARKFLOW_CHAT_CLIENT_ID=
# ARKFLOW_CHAT_AUTOMATION_ID=

# OpenAI (for voice note transcription via Whisper)
OPENAI_API_KEY=

# Comma-separated phone numbers (WhatsApp "from" format, e.g. 85269369092) the bot will respond to.
# Anyone else's message is silently ignored.
ALLOWED_PHONE_NUMBERS=

# Shared secret for POST /api/reply, which the Arkflow portal calls so an operator
# can answer a WhatsApp thread from the dashboard. Must match the value set on the
# portal's whatsapp-reply edge function. Generate with: openssl rand -hex 32
REPLY_API_SECRET=
